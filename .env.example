# ── Firebase (client, existant) ──
# Console Firebase > Paramètres du projet > Vos applications
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Gemini (existant + utilisé par le nouveau parsing de fiche de paie) ──
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Données de marché (existant, optionnel selon les providers utilisés) ──
NEXT_PUBLIC_ALPHA_VANTAGE_API_KEY=
NEXT_PUBLIC_FINNHUB_API_KEY=

# ── NOUVEAU — Firebase Admin (requis pour la route cron serveur) ──
# Console Firebase > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
# Collez tout le contenu du fichier JSON téléchargé sur UNE SEULE ligne (JSON.stringify), entre quotes simples.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── NOUVEAU — Identité du propriétaire (app personnelle mono-utilisateur) ──
# UID Firebase du compte à surveiller (Console Firebase > Authentication > Users > copier l'UID)
OWNER_UID=
# Adresse email qui recevra les rapports périodiques automatiques
OWNER_EMAIL=

# ── NOUVEAU — Resend (envoi d'email des rapports périodiques) ──
# https://resend.com — création de compte gratuite, jusqu'à 3000 emails/mois
RESEND_API_KEY=
# Doit être une adresse d'un domaine vérifié dans Resend (ou onboarding@resend.dev pour tester)
RESEND_FROM_EMAIL=

# ── NOUVEAU — Sécurité de la route cron ──
# Chaîne aléatoire longue de votre choix (ex: générée avec `openssl rand -hex 32`).
# Vercel Cron l'envoie automatiquement dans l'en-tête Authorization une fois configurée
# dans Project Settings > Environment Variables (Vercel la détecte et la joint lui-même).
CRON_SECRET=

# ── NOUVEAU — SnapTrade Personal API (IBKR / Courtages) ──
# Obtenu via console SnapTrade Personal (modèle Read-Only direct)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# ── NOUVEAU — TrueLayer Open Banking DSP2 (BoursoBank / Banques Françaises) ──
# Console TrueLayer > Applications
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_USE_SANDBOX=true

# ── NOUVEAU — URL de base pour les appels serveur-à-serveur du cron (optionnel) ──
# Laissez vide en production sur Vercel : VERCEL_URL est fourni automatiquement.
# Utile seulement pour un déploiement hors Vercel.
APP_BASE_URL=
